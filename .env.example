# Copy this file to .env and fill in the values.

# Required. Long random secret, e.g. `openssl rand -hex 32`. Never commit the real value.
PARSE_MASTER_KEY=

# Optional. MongoDB connection string, e.g. mongodb://localhost:27017/blog-app
# Leave empty to run on an in-memory MongoDB (data is lost on restart).
DATABASE_URI=

# Optional. HTTP port (defaults to 1337).
PORT=1337
